    "formless_bypass_threshold": 0.6,
    "_comment3": "Normalizasyon tuzağı koruması: toplam bu değerin altındaysa zorla 1'e tamamlama",
    "min_total_to_normalize": 0.25
  },
  "lighting_profile": {
    "_comment": "HSV tabanlı aydınlatma profili eşikleri",
    "night_v_threshold": 60.0,
    "golden_h_low": 5.0,
    "golden_h_high": 35.0,
    "golden_s_min": 80.0,
    "golden_ratio_min": 0.25,
    "golden_mean_s_min": 60.0
  },
  "score_routing": {
    "_comment": "Kural tabanli koku duzeltme ve taban garantileri",
    "enabled": true,
    "_comment_vehicle": "Arac tespitinde Is/Duman icin minimum taban skoru",
    "is_duman_vehicle_floor": 0.15
  },
  "ovl": {
    "_comment": "OVL Duyusal Hakem — RTX 3050 CUDA float16. model_id degistirilebilir.",
    "enabled": true,
    "model_id": "openai/clip-vit-base-patch32",
    "hf_token": "",
    "analysis_interval": 15,
    "confidence_threshold": 0.7,
    "_comment_thresholds": "Kural tabanli CLIP karar esikleri",
    "forest_dominance_threshold": 0.6,
    "forest_recalibration_factor": 0.8,
    "min_sea_confidence_for_golden": 0.25
  },
  "dominance_hierarchy": {
    "_comment": "Güçlü koku baskın olduğunda zayıf kokuları maskele",
    "enabled": true,
    "min_dominant_score": 0.22,
    "min_dominant_power": 0.5,
    "max_suppression": 0.45,
    "_comment_coalition": "Doğa Koalisyonu: baskın koku doğa kokusu ise diğer doğa kokuları bu çarpanın altına inemez",
    "nature_scents": [
      "Çam",
      "Toprak",
      "Nane"
    ],
    "nature_coalition_suppress": 0.6
  },
  "vcv": {
    "_comment": "Vektörel Bağlam Doğrulaması — _vector_context_decay ve _compute_context_axes parametreleri",
    "lambda": 2.5,
    "sky_freshness_weight": 0.08,
    "context_axis_clip_weight": 0.95,
    "context_axis_yolo_weight": 0.05,
    "_comment_hardening": "Kentsel baskın sahne (urban>threshold) + doğa kokusu → lambda agresif artar",
    "urban_hardening_threshold": 0.6,
    "urban_hardening_scale": 5.0,
    "_comment_boost": "Kentsel baskın sahne (urban>threshold) → İs/Duman taban bonus: urban_sig * bu değer",
    "urban_is_duman_boost": 0.15,
    "_comment_limon": "Limon Kuzey/Karasal Sertleştirme: Çam+Toprak+İs/Duman toplamı eşiği aşarsa Limon lambda çarpılır",
    "limon_karasal_threshold": 0.45,
    "limon_karasal_scale": 2.0,
    "_comment_terr": "Karasal/Sucul ayrımı — CLIP terrestrial>eşik ise Deniz penalty artar",
    "terrestrial_suppress_threshold": 0.6,
    "terrestrial_suppress_scale": 4.0,
    "aquatic_floor_multiplier": 0.3,
    "_comment_is_terr": "Karasal İs/Duman yumuşatma — dağ/orman/kaya sahnede İs/Duman arka plana çekilir",
    "is_terr_threshold": 0.55,
    "is_terr_scale": 2.0,
    "is_terr_max_penalty": 0.55,
    "is_terr_green_ceil": 0.6,
    "_comment_guard": "VCV Karasal Güvence Katmanı — K-Means yeşil baskınlıkta CLIP hatalı aquatic üretirse düzelti",
    "min_terrestrial_guard": 0.65,
    "max_aquatic_limit_on_green": 0.2,
    "vcv_guard_green_h_low": 55.0,
    "vcv_guard_green_h_high": 140.0,
    "vcv_guard_green_s_min": 40.0
  },
  "clip": {
    "_comment": "CLIP logit softmax sıcaklık parametresi — T<1 baskın skoru öne çıkarır, T>1 düzleştirir",
    "temperature": 0.7
  },
  "texture_aquatic_filter": {
    "_comment": "Yüksek Laplacian (orman/dağ/kayalık) → Deniz ham skorunu baskıla. 0 = devre dışı.",
    "high_texture_threshold": 600.0,
    "penalty": 0.1
  },
  "analyzer": {
    "_comment": "Hareket ve sahne kesme algilama esikleri",
    "motion_diff_threshold": 25,

      "Q": 0.008,
      "R": 0.12
    },
    "Deniz": {
      "Q": 0.015,
      "R": 0.08
    },
    "Vanilya": {
      "Q": 0.01,
      "R": 0.1
    },
    "İs/Duman": {
      "Q": 0.025,
      "R": 0.06
    },
    "Nane": {
      "Q": 0.008,
      "R": 0.15

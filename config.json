    "active_floor_score": 0.15,
    "active_floor_scale": 1.0,
    "terrestrial_dominance_threshold": 0.7,
    "terrestrial_max_aquatic_ratio": 0.25,
    "passive_decay_factor": 0.45
  },
  "temporal": {
    "voting_window": 5,
    "voting_threshold": 0.3
  },
  "clahe": {
    "clip_limit": 2.0,
    "tile_grid_size": [
      8,
      8
    ]
  },
  "hardware": {
    "_comment": "Seri port donanim parametreleri — dashboard.py / get_serial_command_8ch icinde kullanilir",
    "back_flush_ms": 200,
    "purge_ms": 500,
    "min_change_threshold": 0.05,
    "pwm_max": 4095,
    "command_queue_size": 4,
    "stale_command_ms": 300
  },
  "temporal_memory": {
    "half_life_seconds": 2.0,
    "max_objects": 30
  },
  "optical_flow": {
    "water_horizontal_bonus": 0.25,
    "smoke_upward_bonus": 0.2,
    "static_suppression": 0.15,
    "min_magnitude": 0.5,
    "smoke_upward_threshold": 0.3
  },
  "purge_controller": {
    "scene_cut_duration_s": 1.5,
    "score_jump_threshold": 0.5,
    "purge_channel_index": 7
  },
  "saturation_tracker": {
    "window_seconds": 60.0,
    "high_threshold": 0.7,
    "min_output_ratio": 0.4,
    "fade_rate": 0.008
  },
  "dynamic_roi": {
    "focus_labels": [
      "fire",
      "car",
      "truck",
      "boat",
      "fire hydrant",
      "train"
    ],
    "fallback_center_ratio": 0.6
  },
  "color_veto": {
    "_comment": "K-Means yüksek skor verdi ama YOLO desteklemiyorsa cezalandır",
    "enabled": true,
    "kmeans_dominant_threshold": 0.3,
    "yolo_support_min": 0.05,
    "min_blend_to_trigger": 0.12,
    "penalty": 0.5,
